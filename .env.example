# Supabase Public Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# Supabase Server-Only Secret Key (NEVER expose to browser/client, server only)
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key_here
